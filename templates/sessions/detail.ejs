<div>
  <div class="flex items-center justify-between mb-2">
    <button class="btn btn-sm btn-ghost text-pollen" hx-get="/" hx-target="#main-content" hx-push-url="true">&larr; Back</button>
    <% if (startDateFormatted) { %>
      <div class="text-sm text-pollen grid group cursor-default" title="Click or hover to toggle age">
        <span class="col-start-1 row-start-1 transition-opacity duration-300 opacity-100 group-hover:opacity-0 group-active:opacity-0">Age: <%= session.age_formatted %></span>
        <span class="col-start-1 row-start-1 transition-opacity duration-300 opacity-0 group-hover:opacity-100 group-active:opacity-100">Started: <%= startDateFormatted %></span>
      </div>
    <% } else { %>
      <div class="text-sm text-pollen">Age: <%= session.age_formatted %></div>
    <% } %>
  </div>

  <div class="flex justify-between items-center mb-2 mt-2">
    <h2 class="text-3xl font-bold text-base-content flex items-center gap-2">
      <%= session.name %>
      <button class="btn btn-ghost btn-sm text-pollen" onclick="document.getElementById('edit_session_name_modal').showModal()" title="Edit Batch Name">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" /></svg>
      </button>
    </h2>
  </div>

  <div class="flex flex-wrap items-center gap-2 mb-6">
    <span class="badge <%= getBadgeClasses(session.status) %>"><%= session.status === 'Aging' ? 'Aging (Modning)' : session.status %></span>
    <% if (session.is_chemically_stabilized) { %>
      <span class="badge bg-apothecary-teal text-white border-apothecary-teal" id="badge-chemically-stabilized">Chemically Stabilized</span>
    <% } %>
    <% if (session.is_gravity_stable) { %>
      <span class="badge badge-info text-white gap-1" title="Primary fermentation complete (identical SG readings over 7+ days)">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
        </svg>
        Gravity Stable
      </span>
    <% } %>
    <% if (session.fining_state && session.fining_state.stage === 'kieselsol_added') { %>
      <span class="badge badge-warning text-black" id="badge-fining-stage">Fining: Step 1 (Kieselsol)</span>
    <% } else if (session.fining_state && session.fining_state.stage === 'chitosan_ready') { %>
      <span class="badge badge-success text-white" id="badge-fining-stage">Chitosan Window Open (12–24h)</span>
    <% } else if (session.fining_state && session.fining_state.stage === 'chitosan_overdue') { %>
      <span class="badge badge-warning text-black" id="badge-fining-stage">Chitosan Overdue (&gt;24h)</span>
    <% } else if (session.fining_state && session.fining_state.stage === 'sediment_compacting') { %>
      <span class="badge badge-info text-white" id="badge-fining-stage">Compacting (Day <%= (session.fining_state.days_compacting || 0) + 1 %>/14)</span>
    <% } else if (session.fining_state && session.fining_state.stage === 'sediment_compacted') { %>
      <span class="badge badge-success text-white" id="badge-fining-stage">Sediment Compacted</span>
    <% } %>
  </div>

  <div class="stats shadow w-full mb-6 flex-wrap bg-base-100 border border-base-300">
    <div class="stat place-items-center">
      <div class="stat-title text-pollen">Original Gravity</div>
      <div class="stat-value text-2xl text-secondary"><%= ogFormatted %></div>
    </div>
    <div class="stat place-items-center">
      <div class="stat-title text-pollen">Current SG</div>
      <div class="stat-value text-2xl text-secondary flex items-center gap-2">
        <%= currentSgFormatted %>
        <% if (session.current_sg && session.original_sg && session.current_sg < session.original_sg) { %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6" /></svg>
        <% } %>
      </div>
    </div>
    <div class="stat place-items-center">
      <div class="stat-title text-pollen">1/3 Sugar Break</div>
      <div class="stat-value text-2xl text-secondary flex flex-row items-center gap-1">
        <span><%= sugarBreakFormatted %></span>
        <% if (session.is_sugar_break_reached) { %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" title="Break reached" aria-label="Break reached">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        <% } %>        
      </div>
      <% if (session.original_sg) { %>
        <div class="stat-desc text-xs <%= session.is_sugar_break_reached ? 'text-warning font-semibold flex items-center justify-center' : 'text-pollen' %>">
          <% if (!session.is_sugar_break_reached) { %>
            Target threshold
          <% } %>
        </div>
      <% } %>
    </div>
    <div class="stat place-items-center">
      <div class="stat-title text-pollen">Calculated ABV</div>
      <div class="stat-value text-2xl text-secondary"><%= session.abv %>%</div>
    </div>
    <% if (session.estimated_batch_volume !== undefined) { %>
      <div class="stat place-items-center" title="Estimated initial batch volume derived from logged honey/sugars and Original Gravity (~300 gravity points per kg/L). Excludes racking losses.">
        <div class="stat-title text-pollen">Est. Volume</div>
        <div class="stat-value text-2xl text-secondary">~<%= session.estimated_batch_volume.toFixed(1) %> L</div>
      </div>
    <% } %>
    <% if (session.current_ph !== undefined) { %>
      <div class="stat place-items-center">
        <div class="stat-title text-pollen">Current pH</div>
        <div class="stat-value text-2xl <%= (session.current_ph < 3.2 || session.current_ph > 3.8) ? 'text-warning' : 'text-secondary' %>"><%= currentPhFormatted %></div>
        <% if (session.current_ph < 3.2 || session.current_ph > 3.8) { %>
          <div class="stat-desc text-xs text-warning font-semibold">Outside target (3.2–3.8)</div>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Next Steps Card -->
  <%- include('../partials/nextSteps', { session, currentSgFormatted, sugarBreakFormatted }) %>

  <% if (session.current_ph !== undefined && (session.current_ph < 3.2 || session.current_ph > 3.8)) { %>
    <details class="collapse collapse-arrow bg-base-100 border border-warning/50 shadow-sm mb-8" id="ph-guidance-card" open>
      <summary class="collapse-title text-base-content text-lg font-bold flex flex-wrap items-center justify-between gap-2 cursor-pointer select-none pr-12">
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-warning shrink-0" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
          </svg>
          pH Advisory: Outside Optimal Range
        </span>
        <span class="badge badge-warning text-black text-xs font-semibold px-2 py-0.5 mr-2">
          <%= session.current_ph > 3.8 ? 'pH High (> 3.8)' : 'pH Low (< 3.2)' %>
        </span>
      </summary>
      <div class="collapse-content">

        <div class="alert alert-warning bg-warning/15 border border-warning/30 rounded-lg p-3.5 mb-4 flex items-start gap-2.5">
          <span class="text-xl leading-none">⚠️</span>
          <div>
            <div class="text-sm font-bold text-base-content">
              Current pH is <%= currentPhFormatted %>. The optimal pH range for mead is <strong>3.2 to 3.8</strong>.
            </div>
            <div class="text-xs text-base-content/90 mt-1 leading-relaxed">
              <% if (session.current_ph > 3.8) { %>
                A pH reading of <%= currentPhFormatted %> exceeds the recommended threshold of 3.8. Adjusting acidity will protect against spoilage and enhance flavor.
              <% } else { %>
                If the pH value drops below <strong>3.2</strong>, the environment becomes <strong>too acidic for the yeast</strong>.
              <% } %>
            </div>
          </div>
        </div>

        <% if (session.current_ph < 3.2) { %>
          <!-- Key Impacts of a pH Below 3.2 -->
          <div class="mb-4">
            <h4 class="text-sm font-bold text-base-content mb-2 flex items-center gap-1.5">
              <span>⚠️</span> Key Impacts of a pH Below 3.2
            </h4>
            <div class="space-y-2 text-sm text-base-content">
              <div class="flex items-start gap-2 bg-base-200/50 rounded-lg p-3 border border-base-300">
                <span class="text-warning font-bold">1.</span>
                <div>
                  <strong>Yeast Stress &amp; Stalled Fermentation:</strong>
                  The optimal pH range for mead is <strong>3.2 to 3.8</strong>. When the pH drops below 3.2, it becomes too acidic for the yeast, causing cell stress that can severely slow down or completely halt fermentation (<em>stuck fermentation</em>).
                </div>
              </div>
              <div class="flex items-start gap-2 bg-base-200/50 rounded-lg p-3 border border-base-300">
                <span class="text-warning font-bold">2.</span>
                <div>
                  <strong>Harsh Taste:</strong>
                  Excessive acid can make the mead taste overly sharp or sour, masking delicate honey aromatics.
                </div>
              </div>
            </div>
          </div>

          <!-- How to Raise the pH Back to Safety -->
          <div class="bg-base-200/70 rounded-lg p-4 border border-base-300">
            <h4 class="text-sm font-bold text-base-content mb-2 flex items-center gap-1.5">
              <span>⚖️</span> How to Raise the pH Back to Safety
            </h4>
            <p class="text-sm text-base-content mb-2 leading-relaxed">
              To bring the pH back into the optimal <strong>3.2–3.8</strong> range, you can neutralize the excess acid using an alkaline buffering agent:
            </p>
            <ul class="list-disc list-inside text-sm text-base-content space-y-1 ml-1 mb-3">
              <li><strong>Chalk (Calcium Carbonate / <em>Kritt</em>):</strong> Add small amounts of chalk until the pH rises to 3.2 or above.</li>
              <li><strong>Potassium Bicarbonate or Baking Soda (<em>Natron</em>):</strong> Adding calcium or sodium/potassium bicarbonate will also safely raise the pH and protect the yeast.</li>
              <li><em>Tip:</em> Always dissolve the addition thoroughly and re-test with pH strips or a pH meter before adding more.</li>
            </ul>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-base-300/80">
              <div class="text-xs text-pollen">
                💡 <strong>Dosage tip:</strong> Add in small increments and stir gently; re-measure pH before adding more.
              </div>
              <button type="button" class="btn btn-sm btn-warning gap-1" onclick="openBufferModal()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                Log Buffer Addition
              </button>
            </div>
          </div>
        <% } else { %>
          <!-- Why pH Matters During Aging -->
          <div class="mb-4">
            <h4 class="text-sm font-bold text-base-content mb-2 flex items-center gap-1.5">
              <span>🔬</span> Why pH Matters During Aging
            </h4>
            <div class="space-y-2 text-sm text-base-content">
              <div class="flex items-start gap-2 bg-base-200/50 rounded-lg p-3 border border-base-300">
                <span class="text-warning font-bold">1.</span>
                <div>
                  <strong>Microbial Protection &amp; Sulfite Efficiency:</strong>
                  A pH above 3.8 leaves the mead more vulnerable to bacterial spoilage and infection. Furthermore, free sulfur dioxide (SO₂ / Campden) is significantly less effective at higher pH levels, meaning higher amounts of sulfite are required to maintain the same antioxidant and antibacterial shield.
                </div>
              </div>
              <div class="flex items-start gap-2 bg-base-200/50 rounded-lg p-3 border border-base-300">
                <span class="text-warning font-bold">2.</span>
                <div>
                  <strong>Flavor &amp; Balance:</strong>
                  Acidity provides essential structure and crispness that balances residual sweetness and honey body; a pH above 3.8 can leave the mead tasting flat or flabby.
                </div>
              </div>
            </div>
          </div>

          <!-- Recommended Adjustment -->
          <div class="bg-base-200/70 rounded-lg p-4 border border-base-300">
            <h4 class="text-sm font-bold text-base-content mb-2 flex items-center gap-1.5">
              <span>⚖️</span> Recommended Adjustment
            </h4>
            <p class="text-sm text-base-content mb-2 leading-relaxed">
              To lower the pH into the safe, balanced target zone (&le; 3.8), you can adjust the batch using <strong>malic acid (<em>eplesyre</em>)</strong>:
            </p>
            <ul class="list-disc list-inside text-sm text-base-content space-y-1 ml-1 mb-3">
              <li><strong>Dosage:</strong> Add approximately <strong>1 gram of malic acid per liter of mead</strong> to lower the pH down to <strong>3.8 or below</strong>.</li>
              <li><em>Tip:</em> Test with your pH strips after mixing thoroughly to ensure you hit the target 3.2–3.8 window without over-acidifying.</li>
            </ul>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-base-300/80">
              <div class="text-xs text-pollen">
                💡 <strong>Dosage tip:</strong> Add incrementally and stir gently; re-measure pH before adding more.
              </div>
              <button type="button" class="btn btn-sm btn-warning gap-1" onclick="openMalicAcidModal()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                Log Malic Acid Addition
              </button>
            </div>
          </div>
        <% } %>
      </div>
    </details>
  <% } %>


  <% if (chartBundle && chartBundle.sgData && chartBundle.sgData.length > 0) { %>
    <details class="collapse collapse-arrow bg-base-100 border border-base-300 shadow-sm mb-8" id="fermentation-curve-card" open ontoggle="if (this.open && window.fermentationChartInstance) { window.fermentationChartInstance.resize(); }">
      <summary class="collapse-title text-base-content text-lg font-bold flex items-center gap-2 cursor-pointer select-none">
        Fermentation Curve
      </summary>
      <div class="collapse-content">
        <div class="w-full relative pt-2" style="height: 300px;">
          <canvas id="fermentationChart"></canvas>
        </div>
      </div>
    </details>
    <script>
      setTimeout(() => {
        const ctx = document.getElementById('fermentationChart');
        if (!ctx) return;

        const data = <%- chartConfigJSON %>;

        if (window.fermentationChartInstance) {
          window.fermentationChartInstance.destroy();
        }

        window.fermentationChartInstance = new Chart(ctx, {
          type: 'scatter',
          data: {
            datasets: [
              {
                label: 'Specific Gravity',
                data: data.sgData,
                borderColor: '#E5A93C',
                backgroundColor: '#E5A93C',
                yAxisID: 'ySG',
                showLine: true,
                tension: 0.2,
                borderWidth: 3
              },
              {
                label: 'ABV (%)',
                data: data.abvData,
                borderColor: '#4E795B',
                backgroundColor: '#4E795B',
                borderDash: [5, 5],
                yAxisID: 'yABV',
                showLine: true,
                tension: 0.2,
                borderWidth: 2
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              x: {
                type: 'linear',
                title: { display: true, text: 'Days in Fermentation' }
              },
              ySG: {
                type: 'linear',
                position: 'left',
                title: { display: true, text: 'Specific Gravity' },
                ticks: {
                  callback: function(value) { return value.toFixed(3); }
                }
              },
              yABV: {
                type: 'linear',
                position: 'right',
                title: { display: true, text: 'ABV %' },
                grid: { drawOnChartArea: false },
                ticks: {
                  callback: function(value) { return value.toFixed(1) + '%'; }
                }
              }
            },
            plugins: {
              annotation: {
                annotations: data.annotations
              }
            }
          }
        });
      }, 10);
    </script>
  <% } %>

  <!-- Backsweetening Guidance Card -->
  <details class="collapse collapse-arrow bg-base-100 border border-base-300 shadow-sm mb-8" id="backsweetening-guidance-card" open>
    <summary class="collapse-title text-base-content text-lg font-bold flex items-center gap-2 cursor-pointer select-none">
      <% if (session.is_chemically_stabilized) { %>
        <span>Backsweetening Guidance (Ettersøting)</span>
      <% } else { %>
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-warning" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
          </svg>
          Backsweetening Guidance (Locked)
        </span>
      <% } %>
    </summary>
    <div class="collapse-content">

      <% if (session.is_chemically_stabilized) { %>
        <% if (session.backsweetening_events && session.backsweetening_events.length > 0) { %>
          <div class="mb-4">
            <div class="text-xs font-semibold uppercase tracking-wider text-pollen mb-2">Logged Backsweetening Events</div>
            <div class="space-y-2">
              <% session.backsweetening_events.forEach(function(b) { %>
                <div class="bg-base-200/70 border border-base-300 rounded-lg p-3">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="font-semibold text-base-content text-sm">
                      <%= b.ingredient %>
                      <% if (b.quantity_used) { %>
                        <span class="text-secondary font-bold">(<%= formatQuantity(b.quantity_used) %> <%= b.unit || '' %>)</span>
                      <% } %>
                    </div>
                    <div class="text-xs text-pollen"><%= b.date_formatted %></div>
                  </div>
                  <% if (b.note) { %>
                    <div class="text-xs text-base-content/80 mt-1 italic">"<%= b.note %>"</div>
                  <% } %>
                  <div class="flex flex-wrap items-center gap-2 mt-2 pt-2 border-t border-base-300/60 text-xs">
                    <% if (b.measured_sg_delta !== undefined) { %>
                      <span class="font-medium">
                        Measured SG: <%= b.measured_sg_before ? b.measured_sg_before.toFixed(3) : '' %> &rarr; <%= b.measured_sg_after ? b.measured_sg_after.toFixed(3) : '' %>
                        (<%= b.measured_sg_delta >= 0 ? '+' : '' %><%= b.measured_sg_delta.toFixed(3) %> SG)
                      </span>
                    <% } else if (b.measured_sg_before !== undefined) { %>
                      <span class="badge badge-sm badge-ghost text-pollen">
                        Pre-sweetening SG: <%= b.measured_sg_before.toFixed(3) %> (Awaiting post-sweetening reading)
                      </span>
                    <% } %>
                    <% if (b.estimated_sg_delta !== undefined) { %>
                      <span class="text-pollen font-medium" title="Theoretical increase based on sweetener quantity and estimated initial batch volume (~<%= (session.estimated_batch_volume || 10).toFixed(1) %> L)">
                        Approx. SG Increase: <strong class="text-secondary">+<%= b.estimated_sg_delta.toFixed(3) %></strong>
                      </span>
                    <% } %>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } else { %>
          <p class="text-sm text-base-content mb-3 leading-relaxed">
            Batch is <strong>chemically stabilized</strong> with both Potassium Metabisulfite (Campden) and Potassium Sorbate (Sorbistat). Yeast reproduction is safely inhibited, preventing renewed fermentation or bottle bombs when sugars are added.
          </p>
        <% } %>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-3 text-center">
          <div class="bg-base-200/60 rounded-lg p-2">
            <div class="text-xs text-pollen">Dry</div>
            <div class="text-sm font-bold text-secondary">&lt; 1.006</div>
          </div>
          <div class="bg-base-200/60 rounded-lg p-2">
            <div class="text-xs text-pollen">Semi-Sweet</div>
            <div class="text-sm font-bold text-secondary">1.006 – 1.015</div>
          </div>
          <div class="bg-base-200/60 rounded-lg p-2">
            <div class="text-xs text-pollen">Sweet</div>
            <div class="text-sm font-bold text-secondary">1.015 – 1.025</div>
          </div>
          <div class="bg-base-200/60 rounded-lg p-2">
            <div class="text-xs text-pollen">Dessert</div>
            <div class="text-sm font-bold text-secondary">&gt; 1.025</div>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
          <div class="text-xs text-pollen leading-snug">
            <div>💡 <strong>Dosage tip:</strong> Adding ~35 g honey per 1 L of must increases specific gravity by approximately +0.010.</div>
            <% if (session.estimated_batch_volume !== undefined) { %>
              <div class="text-base-content/70 mt-0.5">Calculated batch volume: <strong class="text-secondary">~<%= session.estimated_batch_volume.toFixed(1) %> L</strong> (initial must size; actual volume may be lower due to racking losses and sampling).</div>
            <% } %>
          </div>
          <button type="button" class="btn btn-sm btn-primary gap-1" onclick="openBacksweetenModal()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            <%= (session.backsweetening_events && session.backsweetening_events.length > 0) ? 'Add More Sweetener' : 'Log Backsweetening' %>
          </button>
        </div>
      <% } else { %>
        <p class="text-sm text-base-content mb-2 leading-relaxed">
          <strong>Chemical stabilization is required before backsweetening.</strong> Adding honey or sugars without stabilizers will likely restart fermentation with active or dormant yeast, risking uncontrolled ABV and dangerous <strong>bottle bombs</strong>.
        </p>
        <p class="text-xs text-pollen mb-3 leading-relaxed">
          To safely unlock backsweetening guidance, log an Addition Event containing stabilizer ingredients: <strong>Campden (Potassium Metabisulfite)</strong> + <strong>Sorbistat (Potassium Sorbate)</strong>.
        </p>
        <div class="flex flex-wrap items-center justify-between gap-3 pt-1 border-t border-warning/20">
          <div class="text-xs">
            <% if (session.is_gravity_stable) { %>
              <span class="text-success font-medium flex items-center gap-1">
                ✓ Gravity is stable over 7+ days. Log stabilizers to proceed with sweetening.
              </span>
            <% } else { %>
              <span class="text-pollen flex items-center gap-1">
                ⏳ Gravity stability not confirmed (needs 2 identical SG readings 7+ days apart).
              </span>
            <% } %>
          </div>
          <button type="button" class="btn btn-sm btn-warning gap-1" onclick="openStabilizerModal()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
            Log Stabilizer Addition
          </button>
        </div>
      <% } %>
    </div>
  </details>

  <!-- Clarification & Fining Compaction Countdown Card -->
  <details class="collapse collapse-arrow bg-base-100 border border-base-300 shadow-sm mb-8" id="clarification-fining-card" open>
    <summary class="collapse-title text-base-content text-lg font-bold flex items-center gap-2 cursor-pointer select-none">
      <% if (session.is_racked) { %>
        <span>Clarification &amp; Fining Compaction</span>
      <% } else { %>
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-warning" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
          </svg>
          Clarification &amp; Fining Compaction (Locked)
        </span>
      <% } %>
    </summary>
    <div class="collapse-content">

      <p class="text-sm text-base-content mb-3 leading-relaxed">
        <% if (!session.is_racked) { %>
          <strong>Clarification is first recommended after racking.</strong> Transferring the mead off the heavy primary sediment bed (gross lees) prevents fining agents from being wasted on bulk yeast cake. After racking into secondary, dual-component clarifiers like <strong>Super-Kleer</strong> use opposite electrostatic charges (<strong>Kieselsol [-]</strong> first, followed by <strong>Chitosan [+]</strong> 12–24 hours later) to drop fine suspended haze and initiate the <strong>7 to 14 day sediment compaction countdown</strong> (*bunnfall*).
        <% } else { %>
          After fermentation and chemical stabilization, suspended yeast cells and proteins leave the mead cloudy. Dual-component clarifiers like <strong>Super-Kleer</strong> use opposite electrostatic charges: <strong>Kieselsol [-]</strong> is added first, followed by <strong>Chitosan [+]</strong> 12–24 hours later to flocculate particles and initiate a <strong>7 to 14 day sediment compaction countdown</strong> (*bunnfall*).
        <% } %>
      </p>

      <p class="text-sm text-base-content mb-3 leading-relaxed">
        Cold crashing the carboy (2–4°C) accelerates sediment bed compaction and ensures a tight, disturbance-resistant cake.
      </p>

      <!-- Two-Component Schedule Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
        <!-- Step 1: Kieselsol [-] -->
        <div class="bg-base-200/60 rounded-lg p-3.5 border border-base-300">
          <div class="flex items-center justify-between mb-1">
            <div class="font-bold text-sm text-base-content flex items-center gap-1.5">
              <span class="badge badge-xs <%= session.fining_state && session.fining_state.kieselsol_event ? 'badge-success' : 'badge-pollen' %>">1</span>
              Component 1: Kieselsol [-]
            </div>
          </div>
          <div class="text-xs text-pollen leading-snug">
            Negatively charged silica sol binds positively charged yeast proteins. Disperses through the mead over 12–24 hours.
          </div>
          <% if (session.fining_state && session.fining_state.kieselsol_time) { %>
            <div class="text-xs text-success mt-2 font-medium">
              ✓ Added <%= formatDateTimeForDisplay(session.fining_state.kieselsol_time) %>
            </div>
            <% } else { %>
              <div class="text-xs text-pollen font-medium">Pending</div>            
          <% } %>
        </div>

        <!-- Step 2: Chitosan [+] -->
        <div class="bg-base-200/60 rounded-lg p-3.5 border border-base-300">
          <div class="flex items-center justify-between mb-1">
            <div class="font-bold text-sm text-base-content flex items-center gap-1.5">
              <span class="badge badge-xs <%= session.fining_state && session.fining_state.chitosan_event ? 'badge-success' : 'badge-pollen' %>">2</span>
              Component 2: Chitosan [+]
            </div>
            <% if (session.fining_state && session.fining_state.stage === 'chitosan_ready') { %>
              <span class="text-xs text-success font-semibold">Ready to Add!</span>
            <% } else if (session.fining_state && session.fining_state.stage === 'kieselsol_added') { %>
              <span class="text-xs text-warning font-semibold">Wait <%= session.fining_state.hours_until_chitosan_window %>h</span>
            <% } %>
          </div>
          <div class="text-xs text-pollen leading-snug">
            Positively charged polymer neutralizes remaining charges and creates heavy flocs that precipitate rapidly to the bottom.
          </div>
          <% if (session.fining_state && session.fining_state.chitosan_time) { %>
            <div class="text-xs text-success mt-2 font-medium">
              ✓ Added <%= formatDateTimeForDisplay(session.fining_state.chitosan_time) %>
            </div>
          <% } %>
        </div>
      </div>

      <% if (session.fining_state && (session.fining_state.stage === 'sediment_compacting' || session.fining_state.stage === 'sediment_compacted')) { %>
        <!-- Sediment Compaction Timer -->
        <div class="bg-base-200/80 rounded-lg p-4 border border-base-300 mb-4" id="sediment-compaction-timer">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
            <h4 class="font-bold text-sm text-base-content flex items-center gap-1.5">
              Sediment Bed Compaction Timer (<em>Bunnfall-komprimering</em>)
            </h4>
            <% if (session.fining_state.safe_to_siphon) { %>
              <span class="badge badge-success text-white text-xs font-semibold px-2 py-0.5">Safe to Siphon into Bottles</span>
            <% } else { %>
              <span class="badge badge-warning text-black text-xs font-semibold px-2 py-0.5">Sediment Settling (Do Not Siphon)</span>
            <% } %>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-3 text-center">
            <div class="bg-base-100 rounded-lg p-2 border border-base-300">
              <div class="text-xs text-pollen">Compacting Days</div>
              <div class="text-lg font-bold text-secondary">Day <%= (session.fining_state.days_compacting || 0) + 1 %></div>
            </div>
            <div class="bg-base-100 rounded-lg p-2 border border-base-300">
              <div class="text-xs text-pollen">Days Remaining</div>
              <div class="text-lg font-bold text-secondary"><%= session.fining_state.days_remaining_to_compact %> days</div>
            </div>
            <div class="bg-base-100 rounded-lg p-2 border border-base-300">
              <div class="text-xs text-pollen">Compaction Progress</div>
              <div class="text-lg font-bold text-secondary"><%= session.fining_state.compaction_progress_pct %>%</div>
            </div>
            <div class="bg-base-100 rounded-lg p-2 border border-base-300">
              <div class="text-xs text-pollen">Siphoning Safety</div>
              <div class="text-sm font-bold <%= session.fining_state.safe_to_siphon ? 'text-success' : 'text-warning' %>">
                <%= session.fining_state.safe_to_siphon ? 'Safe & Clear' : 'Haze Risk' %>
              </div>
            </div>
          </div>

          <!-- Progress Bar with Milestones -->
          <div class="space-y-1 mb-3">
            <div class="flex justify-between text-xs text-pollen font-medium">
              <span>Day 0: Flocculation</span>
              <span>Day 7: Loose Bed Settled</span>
              <span>Day 14: Tight Compaction</span>
            </div>
            <progress class="progress progress-secondary w-full" value="<%= session.fining_state.compaction_progress_pct %>" max="100"></progress>
          </div>

          <div class="text-xs leading-relaxed">
            <% if (session.fining_state.sediment_phase === 'loose') { %>
              <span class="text-warning font-semibold">⚠️ Days 0–6 (Loose Bed):</span>
              The sediment bed is fluffy and loose. The slightest movement or siphoning will draw haze into the pour. Keep the vessel stationary.
            <% } else if (session.fining_state.sediment_phase === 'compacting') { %>
              <span class="font-semibold">Days 7–13 (Compacting):</span>
              The sediment bed is compressing into a tighter layer. For maximum crystal clarity and haze-free pouring, wait until Day 14 for the sediment bed to reach full density.
            <% } else { %>
              <span class="text-success font-semibold">✓ Day 14+ (Compacted):</span>
              The sediment bed is compressed into a firm layer (*kompakt bunnfall*) at the bottom. It is now safe to siphon into bottles without pulling haze into the final pour.
            <% } %>
          </div>
        </div>
      <% } %>

      <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-base-300/80">
        <div class="flex gap-2 flex-wrap">
          <% if (!session.is_racked) { %>
            <button type="button" class="btn btn-sm btn-warning gap-1" onclick="document.getElementById('event-type-select').value='racking'; openAddEventModal();">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" /></svg>
              Log Racking
            </button>
          <% } %>
          <% if (!session.fining_state || session.fining_state.stage === 'none' || session.fining_state.stage === 'chitosan_overdue') { %>
            <button type="button" class="btn btn-sm btn-warning gap-1" onclick="openKieselsolModal()">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              Log Kieselsol [-]
            </button>
          <% } %>
          <% if (!session.fining_state || session.fining_state.stage === 'kieselsol_added' || session.fining_state.stage === 'chitosan_ready' || session.fining_state.stage === 'chitosan_overdue') { %>
            <button type="button" class="btn btn-sm <%= session.fining_state && session.fining_state.stage === 'chitosan_ready' ? 'btn-success text-white' : 'btn-secondary' %> gap-1" onclick="openChitosanModal()">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
              Log Chitosan [+]
            </button>
          <% } %>
          <% if (session.fining_state && session.fining_state.safe_to_siphon) { %>
            <button type="button" class="btn btn-sm btn-success text-white gap-1" onclick="document.getElementById('event-type-select').value='bottling'; openAddEventModal();">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Log Bottling
            </button>
          <% } %>
        </div>
      </div>
    </div>
  </details>

  <div class="flex items-center justify-between mb-4">
    <h3 id="event-history-title" class="text-xl font-bold text-base-content scroll-mt-4">Event History</h3>
    <button type="button" class="btn btn-primary btn-sm gap-1" onclick="openAddEventModal()">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
      Log Event
    </button>
  </div>

  <div class="pb-6">
    <ul class="timeline timeline-vertical grid grid-cols-[max-content_auto_1fr] gap-x-6 [&>li]:grid-cols-[max-content_auto_1fr] [&>li]:grid-cols-subgrid [&>li]:col-span-3 [&>li]:gap-x-1 [&>li]:lg:gap-x-6">
      <% if (session.events && session.events.length > 0) { %>
        <%
          const sortedEvents = [...session.events].sort(function(a, b) {
            return new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime();
          });
          const startDate = session.start_date || (sortedEvents[0] && sortedEvents[0].timestamp);
          const reversedEvents = [...sortedEvents].reverse();
          const invMap = new Map(inventoryList.map(function(i) { return [i.id, i]; }));
        %>
        <% reversedEvents.forEach(function(e, index, arr) { %>
          <li>
            <% if (index > 0) { %><hr/><% } %>
            <div class="timeline-start whitespace-nowrap justify-self-start text-left m-0">
              <div class="text-sm font-semibold text-base-content"><%= formatTimelineDay(e.timestamp, startDate) %></div>
              <div class="text-xs text-pollen"><%= formatTimelineDate(e.timestamp) %></div>
            </div>
            <div class="timeline-middle bg-base-100 rounded-full p-1 shadow-sm border border-base-300">
              <%- getEventIcon(e.type) %>
            </div>
            <div class="timeline-end timeline-box bg-base-100 border-base-300 p-4 w-full justify-self-stretch flex items-center gap-3 shadow-md my-2 mx-0">
              <div class="flex flex-col flex-grow min-w-0">
                <span class="font-bold text-sm uppercase text-base-content"><%= e.type === "ph_reading" ? "pH Reading" : e.type.replace("_", " ") %></span>
                <% if (e.type === "sg_reading") { %>
                  <% const sgStr = e.data && e.data.sg !== undefined ? e.data.sg.toFixed(3) : ""; %>
                  <% const note = (e.data && e.data.note || "").trim(); %>
                  <% if (sgStr) { %><div class="text-xs text-pollen mt-0.5"><%= sgStr %></div><% } %>
                  <% if (note) { %><div class="text-xs text-pollen mt-0.5 leading-snug"><%= note %></div><% } %>
                <% } else if (e.type === "ph_reading") { %>
                  <% const phVal = e.data && e.data.ph !== undefined ? ("pH " + Number(e.data.ph).toFixed(2)) : ""; %>
                  <% const note = (e.data && e.data.note || "").trim(); %>
                  <% if (phVal) { %><div class="text-xs text-pollen font-medium mt-0.5"><%= phVal %></div><% } %>
                  <% if (note) { %><div class="text-xs text-pollen mt-0.5 leading-snug"><%= note %></div><% } %>
                <% } else if (e.type === "addition") { %>
                  <%
                    let itemText = "";
                    if (e.data && e.data.inventory_item_id) {
                      const invItem = invMap.get(e.data.inventory_item_id);
                      if (invItem) {
                        itemText = (invItem.name + (e.data.quantity_used ? ": " + e.data.quantity_used + " " + (e.data.unit || invItem.unit || "") : "")).trim();
                      }
                    } else if (e.data && e.data.ingredient) {
                      itemText = (e.data.ingredient + (e.data.quantity_used ? ": " + e.data.quantity_used + " " + (e.data.unit || "") : "")).trim();
                    }
                    const note = (e.data && e.data.note || "").trim();
                  %>
                  <% if (itemText) { %><div class="text-xs text-pollen font-medium mt-0.5"><%= itemText %></div><% } %>
                  <% if (note) { %><div class="text-sm text-base-content mt-1 leading-snug"><%= note %></div><% } %>
                <% } else if (e.type === "comment") { %>
                  <div class="text-sm text-base-content mt-0.5 leading-snug"><%= (e.data && e.data.note) || "" %></div>
                <% } else if (e.data && e.data.note) { %>
                  <div class="text-sm text-base-content mt-0.5 leading-snug"><%= e.data.note %></div>
                <% } %>
              </div>
              <button class="btn btn-ghost btn-xs text-primary ml-auto" data-event-id="<%= e.id %>" data-delete-url="/sessions/<%= session.id %>/events/<%= e.id %>" onclick='openEditEventModal(<%- JSON.stringify(e).replace(/'/g, "&#39;") %>)' title="Edit Event">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" /></svg>
              </button>
            </div>
            <% if (index < arr.length - 1) { %><hr/><% } %>
          </li>
        <% }); %>
      <% } else { %>
        <div class="text-pollen">No events logged yet.</div>
      <% } %>
    </ul>
  </div>

  <%- include('../partials/ingredientsUsed', { usage: inventoryUsage, inventoryList: inventoryList, sessionId: session.id }) %>

  <!-- Add / Edit Event Modal -->
  <dialog id="event_modal" class="modal">
    <div class="modal-box">
      <h3 id="event-modal-title" class="font-bold text-lg mb-4 text-base-content">Log Event</h3>
      <form id="event-form" hx-post="/sessions/<%= session.id %>/events" hx-target="#main-content" hx-swap="innerHTML show:#event-history-title:top focus-scroll:false" onsubmit="document.getElementById('event_modal').close()">
        <input type="hidden" name="id" id="event-id" />

        <div class="form-control w-full mb-3" id="event-type-container">
          <label class="label"><span class="label-text">Event Type</span></label>
          <select name="type" id="event-type-select" class="select select-bordered w-full" required onchange="updateEventModalFields()">
            <option value="sg_reading">SG Reading</option>
            <option value="ph_reading">pH Reading</option>
            <option value="addition">Addition (Nutrients, etc.)</option>
            <option value="racking">Racking</option>
            <option value="bottling">Bottling</option>
            <option value="comment">Comment</option>
          </select>
          <p id="event-description" class="text-xs text-pollen mt-1 leading-tight"></p>
        </div>

        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Date & Time</span></label>
          <input type="datetime-local" name="timestamp" id="event-timestamp-input" required class="input input-bordered w-full" />
        </div>

        <!-- SG Container (for sg_reading) -->
        <div id="sg-data-container" class="form-control w-full mb-3">
          <label class="label"><span class="label-text">SG Value</span></label>
          <input type="number" step="0.001" name="sg" id="event-sg-input" class="input input-bordered w-full" placeholder="e.g. 1.090" />
        </div>

        <!-- pH Container (for ph_reading) -->
        <div id="ph-data-container" class="form-control w-full mb-3 hidden">
          <label class="label"><span class="label-text">pH Value</span></label>
          <input type="number" step="0.01" min="0" max="14" name="ph" id="event-ph-input" class="input input-bordered w-full" placeholder="e.g. 3.60" />
        </div>

        <!-- Addition Container (for addition) -->
        <div id="addition-data-container" class="hidden flex-col gap-3 mb-3">
          <div class="form-control w-full">
            <label class="label"><span class="label-text">Inventory Item</span></label>
            <select name="inventory_item_id" id="event-inventory-select" class="select select-bordered w-full" onchange="toggleCustomIngredient()">
              <option value="">-- Custom / Not in Inventory --</option>
              <% inventoryList.forEach(function(i) { %>
                <option value="<%= i.id %>" data-unit="<%= i.unit %>"><%= i.name %> (Stock: <%= i.quantity_on_hand %> <%= i.unit %>)</option>
              <% }); %>
            </select>
          </div>
          <div class="form-control w-full hidden" id="custom-ingredient-container">
            <label class="label"><span class="label-text">Ingredient Name</span></label>
            <input type="text" name="custom_ingredient" id="custom-ingredient-input" class="input input-bordered w-full" placeholder="e.g. Cinnamon Stick" />
          </div>
          <div class="flex gap-2">
            <div class="form-control w-1/2">
              <label class="label"><span class="label-text">Quantity</span></label>
              <input type="number" step="any" name="quantity_used" id="quantity-used-input" class="input input-bordered w-full" />
            </div>
            <div class="form-control w-1/2">
              <label class="label"><span class="label-text">Unit</span></label>
              <select name="unit" id="unit-select" class="select select-bordered w-full">
                <option value="g">g</option>
                <option value="kg">kg</option>
                <option value="ml">ml</option>
                <option value="L">L</option>
                <option value="packets">packets</option>
                <option value="oz">oz</option>
                <option value="lb">lb</option>
                <option value="tsp">tsp</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Note Container (available for all event types) -->
        <div id="event-note-container" class="form-control w-full mb-3">
          <label class="label"><span class="label-text" id="event-note-label">Note (Optional)</span></label>
          <input type="text" name="note" id="event-note-input" class="input input-bordered w-full" placeholder="e.g. Additional notes or observations" />
        </div>

        <div class="modal-action flex justify-between items-center w-full">
          <div>
            <button type="button" id="event-delete-btn" class="btn btn-error gap-1.5 hidden" hx-target="#main-content" hx-swap="innerHTML show:#event-history-title:top focus-scroll:false" hx-confirm="Are you sure you want to delete this event?" hx-params="none" title="Delete Event">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
              Delete
            </button>
          </div>
          <div class="flex gap-2">
            <button type="button" class="btn" onclick="document.getElementById('event_modal').close()">Cancel</button>
            <button type="submit" id="event-submit-btn" class="btn btn-primary">Log Event</button>
          </div>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <!-- Edit Session Name Modal -->
  <dialog id="edit_session_name_modal" class="modal">
    <div class="modal-box">
      <h3 class="font-bold text-lg mb-4">Edit Batch Name</h3>
      <form hx-post="/sessions/<%= session.id %>/name" hx-target="#main-content" onsubmit="document.getElementById('edit_session_name_modal').close()">
        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Name</span></label>
          <input type="text" name="name" required class="input input-bordered w-full" value="<%= session.name %>" />
        </div>
        <div class="modal-action">
          <button type="button" class="btn" onclick="document.getElementById('edit_session_name_modal').close()">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <script>
    function toggleCustomIngredient() {
      const select = document.getElementById('event-inventory-select');
      const customContainer = document.getElementById('custom-ingredient-container');
      const unitSelect = document.getElementById('unit-select');
      if (select.value === "") {
        customContainer.classList.remove('hidden');
      } else {
        customContainer.classList.add('hidden');
        const selectedOption = select.options[select.selectedIndex];
        if (selectedOption && selectedOption.dataset.unit) {
           unitSelect.value = selectedOption.dataset.unit;
        }
      }
    }

    function updateEventModalFields() {
      const type = document.getElementById('event-type-select').value;
      const desc = document.getElementById('event-description');

      const sgContainer = document.getElementById('sg-data-container');
      const sgInput = document.getElementById('event-sg-input');

      const phContainer = document.getElementById('ph-data-container');
      const phInput = document.getElementById('event-ph-input');

      const additionContainer = document.getElementById('addition-data-container');
      const qtyInput = document.getElementById('quantity-used-input');

      const noteLabel = document.getElementById('event-note-label');
      const noteInput = document.getElementById('event-note-input');
      noteInput.required = false;

      if (type === 'addition') {
         sgContainer.classList.add('hidden');
         sgInput.required = false;
         phContainer.classList.add('hidden');
         phInput.required = false;

         additionContainer.classList.remove('hidden');
         additionContainer.classList.add('flex');
         qtyInput.required = true;
         toggleCustomIngredient();

         desc.innerText = "Log additions like yeast pitching, nutrients, fruit, or spices.";
         noteLabel.innerText = "Note (Optional)";
         noteInput.placeholder = "e.g. Staggered addition, stirred well";
      } else if (type === 'sg_reading') {
         additionContainer.classList.add('hidden');
         additionContainer.classList.remove('flex');
         qtyInput.required = false;
         phContainer.classList.add('hidden');
         phInput.required = false;

         sgContainer.classList.remove('hidden');
         sgInput.required = true;

         desc.innerText = "Record the Specific Gravity (SG). The first reading acts as your Original Gravity (OG).";
         noteLabel.innerText = "Note (Optional)";
         noteInput.placeholder = "e.g. Activity slowing, clear must";
      } else if (type === 'ph_reading') {
         additionContainer.classList.add('hidden');
         additionContainer.classList.remove('flex');
         qtyInput.required = false;
         sgContainer.classList.add('hidden');
         sgInput.required = false;

         phContainer.classList.remove('hidden');
         phInput.required = true;

         desc.innerText = "Record the pH of the must or mead (typical range 3.20 – 4.00).";
         noteLabel.innerText = "Note (Optional)";
         noteInput.placeholder = "e.g. Must tested before pitch, or adjusted with potassium bicarbonate";
      } else if (type === 'racking') {
         sgContainer.classList.add('hidden');
         sgInput.required = false;
         phContainer.classList.add('hidden');
         phInput.required = false;

         additionContainer.classList.add('hidden');
         additionContainer.classList.remove('flex');
         qtyInput.required = false;

         desc.innerText = "Transfer off the sediment (lees) to a new vessel. Progresses the batch to Aging.";
         noteLabel.innerText = "Notes (Optional)";
         noteInput.placeholder = "e.g. Racked to glass carboy, minimal headspace";
      } else if (type === 'bottling') {
         sgContainer.classList.add('hidden');
         sgInput.required = false;
         phContainer.classList.add('hidden');
         phInput.required = false;

         additionContainer.classList.add('hidden');
         additionContainer.classList.remove('flex');
         qtyInput.required = false;

         desc.innerText = "Final packaging. Completes the batch and moves it to Bottled.";
         noteLabel.innerText = "Notes (Optional)";
         noteInput.placeholder = "e.g. Yielded 10 bottles, primed with honey";
      } else if (type === 'comment') {
         sgContainer.classList.add('hidden');
         sgInput.required = false;
         phContainer.classList.add('hidden');
         phInput.required = false;

         additionContainer.classList.add('hidden');
         additionContainer.classList.remove('flex');
         qtyInput.required = false;

         desc.innerText = "Add a note, observation, or tasting comment for this batch.";
         noteLabel.innerText = "Note";
         noteInput.required = true;
         noteInput.placeholder = "e.g. Degassed carboy, tasting notes, clarity observations...";
      }
    }

    function openAddEventModal() {
      const modal = document.getElementById('event_modal');
      const form = document.getElementById('event-form');
      document.getElementById('event-modal-title').innerText = "Log Event";
      document.getElementById('event-submit-btn').innerText = "Log Event";

      const deleteBtn = document.getElementById('event-delete-btn');
      if (deleteBtn) {
        deleteBtn.classList.add('hidden');
        deleteBtn.removeAttribute('hx-delete');
      }

      form.setAttribute('hx-post', '/sessions/<%= session.id %>/events');
      htmx.process(form);

      document.getElementById('event-id').value = "";
      document.getElementById('event-type-select').value = "sg_reading";

      const tzOffset = (new Date()).getTimezoneOffset() * 60000;
      const localISOTime = (new Date(Date.now() - tzOffset)).toISOString().slice(0, 16);
      document.getElementById('event-timestamp-input').value = localISOTime;

      document.getElementById('event-sg-input').value = "";
      document.getElementById('event-ph-input').value = "";
      document.getElementById('event-inventory-select').value = "";
      document.getElementById('custom-ingredient-input').value = "";
      document.getElementById('quantity-used-input').value = "";
      document.getElementById('unit-select').value = "g";
      document.getElementById('event-note-input').value = "";

      updateEventModalFields();
      modal.showModal();
    }

    function openEditEventModal(event) {
      const modal = document.getElementById('event_modal');
      const form = document.getElementById('event-form');
      document.getElementById('event-modal-title').innerText = "Edit Event";
      document.getElementById('event-submit-btn').innerText = "Save Changes";

      const deleteBtn = document.getElementById('event-delete-btn');
      if (deleteBtn) {
        deleteBtn.setAttribute('hx-delete', '/sessions/<%= session.id %>/events/' + event.id);
        deleteBtn.classList.remove('hidden');
        htmx.process(deleteBtn);
      }

      form.setAttribute('hx-post', '/sessions/<%= session.id %>/events/edit');
      htmx.process(form);

      document.getElementById('event-id').value = event.id;
      document.getElementById('event-type-select').value = event.type;

      const localTime = new Date(new Date(event.timestamp).getTime() - (new Date().getTimezoneOffset() * 60000)).toISOString().slice(0, 16);
      document.getElementById('event-timestamp-input').value = localTime;

      document.getElementById('event-sg-input').value = "";
      document.getElementById('event-ph-input').value = "";
      document.getElementById('event-inventory-select').value = "";
      document.getElementById('custom-ingredient-input').value = "";
      document.getElementById('quantity-used-input').value = "";
      document.getElementById('unit-select').value = "g";
      document.getElementById('event-note-input').value = event.data?.note || '';

      if (event.type === 'sg_reading') {
        document.getElementById('event-sg-input').value = event.data?.sg !== undefined ? event.data.sg : '';
      } else if (event.type === 'ph_reading') {
        document.getElementById('event-ph-input').value = event.data?.ph !== undefined ? event.data.ph : '';
      } else if (event.type === 'addition') {
        if (event.data?.inventory_item_id) {
          document.getElementById('event-inventory-select').value = event.data.inventory_item_id;
        } else {
          document.getElementById('event-inventory-select').value = "";
          document.getElementById('custom-ingredient-input').value = event.data?.ingredient || '';
        }
        if (event.data?.quantity_used !== undefined) {
          document.getElementById('quantity-used-input').value = event.data.quantity_used;
        }
        if (event.data?.unit) {
          document.getElementById('unit-select').value = event.data.unit;
        }
      }

      updateEventModalFields();
      modal.showModal();
    }

    function openMalicAcidModal() {
      openAddEventModal();
      document.getElementById('event-type-select').value = 'addition';
      updateEventModalFields();
      const invSelect = document.getElementById('event-inventory-select');
      let found = false;
      for (let i = 0; i < invSelect.options.length; i++) {
        if (/malic|eplesyre|acid|syre/i.test(invSelect.options[i].text)) {
          invSelect.selectedIndex = i;
          toggleCustomIngredient();
          found = true;
          break;
        }
      }
      if (!found) {
        invSelect.value = "";
        toggleCustomIngredient();
        document.getElementById('custom-ingredient-input').value = 'Malic Acid (Eplesyre)';
      }
      document.getElementById('unit-select').value = 'g';
      document.getElementById('event-note-input').value = 'pH adjustment: Add ~1 g/L malic acid to lower pH to <= 3.8';
    }

