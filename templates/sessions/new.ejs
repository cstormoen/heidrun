<div>
  <h2 class="text-3xl font-bold mb-6 text-base-content">Start nytt brygg</h2>
  <form hx-post="/sessions" hx-target="#main-content" hx-push-url="/" class="flex flex-col gap-4">
    <div class="form-control w-full max-w-sm">
      <label class="label"><span class="label-text">Navn på brygget</span></label>
      <input type="text" name="name" placeholder="f.eks. Sommermelomel" required class="input input-bordered w-full max-w-sm" />
    </div>
    <div class="form-control w-full max-w-sm">
      <label class="label"><span class="label-text">Oppskrift / Grunnoppskrift</span></label>
      <select name="recipe_id" id="recipe-select" class="select select-bordered" required onchange="updateRecipeDesc()">
        <% recipes.forEach(function(r) { %>
          <option value="<%= r.id %>" data-desc="<%- r.safeDescription %>"><%= r.name %></option>
        <% }); %>
      </select>
      <p id="recipe-desc" class="text-sm text-pollen mt-2 leading-tight"></p>
    </div>
    <div class="mt-4 flex gap-2">
      <button type="submit" class="btn btn-primary">Start brygging</button>
      <button type="button" class="btn btn-ghost" hx-get="/" hx-target="#main-content" hx-push-url="true">Avbryt</button>
    </div>
  </form>
  <script>
    function updateRecipeDesc() {
      const select = document.getElementById('recipe-select');
      if (select && select.options.length > 0) {
        const desc = select.options[select.selectedIndex].getAttribute('data-desc');
        document.getElementById('recipe-desc').innerHTML = desc || '';
      }
    }
    updateRecipeDesc();
  </script>
</div>
