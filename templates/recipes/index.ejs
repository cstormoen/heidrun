<div>
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Oppskrifter</h1>
    <button class="btn btn-primary" onclick="openCreateModal()">Ny oppskrift</button>
  </div>

  <!-- Standardoppskrifter -->
  <div class="mb-8">
    <h2 class="text-xl font-bold text-base-content border-b border-base-300 pb-2 mb-4">Standardoppskrifter</h2>
    <% if (starterRecipes.length === 0) { %>
      <div class="text-center py-6 opacity-60">Ingen standardoppskrifter tilgjengelig.</div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% starterRecipes.forEach(function(vm) { %>
          <%- include('./card', { vm }) %>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Mine oppskrifter -->
  <div class="mb-8">
    <h2 class="text-xl font-bold text-base-content border-b border-base-300 pb-2 mb-4">Mine oppskrifter</h2>
    <% if (customRecipes.length === 0) { %>
      <div class="text-center py-8 bg-base-100 rounded-box border border-base-300 opacity-70">
        <p class="font-medium">Ingen egne oppskrifter ennå.</p>
        <p class="text-sm text-pollen mt-1">Trykk på «Ny oppskrift» for å lage din egen oppskrift.</p>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <% customRecipes.forEach(function(vm) { %>
          <%- include('./card', { vm }) %>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Dialog for ny oppskrift -->
  <dialog id="add_recipe_modal" class="modal">
    <div class="modal-box">
      <h3 class="font-bold text-lg mb-4">Ny oppskrift</h3>
      <form id="add-recipe-form" hx-post="/oppskrifter" hx-target="#main-content" hx-push-url="true" onsubmit="document.getElementById('add_recipe_modal').close()">
        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Navn</span></label>
          <input type="text" name="name" required class="input input-bordered w-full" placeholder="f.eks. Bringebærmjød" />
        </div>
        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Mål for startvekt (Target SG)</span></label>
          <input type="number" step="0.001" name="target_sg" class="input input-bordered w-full" placeholder="f.eks. 1.110" />
        </div>
        <div class="form-control w-full mb-5">
          <label class="label"><span class="label-text">Beskrivelse</span></label>
          <textarea name="description" rows="4" class="textarea textarea-bordered w-full" placeholder="Fremgangsmåte, råvarer og notater..."></textarea>
        </div>
        <div class="modal-action">
          <button type="button" class="btn" onclick="document.getElementById('add_recipe_modal').close()">Avbryt</button>
          <button type="submit" class="btn btn-primary">Lagre</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>lukk</button>
    </form>
  </dialog>

  <!-- Dialog for rediger oppskrift -->
  <dialog id="edit_recipe_modal" class="modal">
    <div class="modal-box">
      <h3 class="font-bold text-lg mb-4">Rediger oppskrift</h3>
      <form id="edit-recipe-form" hx-post="/oppskrifter/edit" hx-target="#main-content" hx-push-url="true" onsubmit="document.getElementById('edit_recipe_modal').close()">
        <input type="hidden" name="id" id="edit-recipe-id" />
        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Navn</span></label>
          <input type="text" name="name" id="edit-recipe-name" required class="input input-bordered w-full" />
        </div>
        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Mål for startvekt (Target SG)</span></label>
          <input type="number" step="0.001" name="target_sg" id="edit-recipe-target-sg" class="input input-bordered w-full" placeholder="f.eks. 1.110" />
        </div>
        <div class="form-control w-full mb-5">
          <label class="label"><span class="label-text">Beskrivelse</span></label>
          <textarea name="description" id="edit-recipe-description" rows="4" class="textarea textarea-bordered w-full" placeholder="Fremgangsmåte, råvarer og notater..."></textarea>
        </div>
        <div class="modal-action flex justify-between items-center">
          <button type="button" class="btn btn-ghost text-error" onclick="deleteCurrentRecipe()">Slett</button>
          <div class="flex gap-2">
            <button type="button" class="btn" onclick="document.getElementById('edit_recipe_modal').close()">Avbryt</button>
            <button type="submit" class="btn btn-primary">Lagre</button>
          </div>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>lukk</button>
    </form>
  </dialog>

  <script>
    function openCreateModal() {
      const form = document.getElementById('add-recipe-form');
      if (form) form.reset();
      document.getElementById('add_recipe_modal').showModal();
    }

    function openEditModal(recipe) {
      document.getElementById('edit-recipe-id').value = recipe.id;
      document.getElementById('edit-recipe-name').value = recipe.name || '';
      document.getElementById('edit-recipe-target-sg').value = (recipe.target_sg !== null && recipe.target_sg !== undefined) ? recipe.target_sg : '';
      document.getElementById('edit-recipe-description').value = recipe.description || '';
      document.getElementById('edit_recipe_modal').showModal();
    }

    function deleteCurrentRecipe() {
      const id = document.getElementById('edit-recipe-id').value;
      if (!id) return;
      if (confirm('Er du sikker på at du vil slette denne oppskriften?')) {
        document.getElementById('edit_recipe_modal').close();
        htmx.ajax('DELETE', '/oppskrifter/' + id, { target: '#main-content', pushUrl: true });
      }
    }
  </script>
</div>
