<div>
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">Stabbur</h1>
    <button class="btn btn-primary" onclick="document.getElementById('add_inventory_modal').showModal()">Legg til vare</button>
  </div>
  
  <% if (!hasItems) { %>
    <div class="text-center py-10 opacity-60">Stabburet er tomt.</div>
  <% } else { %>
    <% categories.forEach(function(cat) { %>
      <% if (cat.items.length > 0) { %>
        <div class="mb-6">
          <h3 class="text-lg font-bold text-base-content border-b border-base-300 pb-2 mb-3"><%= cat.category %></h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% cat.items.forEach(function(vm) { %>
              <div class="card bg-base-100 shadow-sm border border-base-300">
                <div class="card-body p-4">
                  <div class="flex justify-between items-start">
                    <div>
                      <h4 class="font-semibold text-base-content flex items-center gap-2">
                        <%= vm.item.name %>
                      </h4>
                      <div class="text-xs text-pollen mt-1"><%= vm.unitPriceFormatted %></div>
                    </div>
                    <div class="text-right">
                      <div class="text-xl font-bold text-secondary"><%= vm.quantityFormatted %></div>
                      <div class="text-xs text-pollen uppercase"><%= vm.item.unit %></div>
                    </div>
                  </div>
                  <div class="mt-2 pt-2 border-t border-base-200 flex justify-end items-center gap-2">
                    <% if (vm.domainLink) { %>
                      <a href="<%= vm.domainLink.url %>" target="_blank" rel="noopener noreferrer" class="btn btn-xs btn-outline text-primary mr-auto">Gå til <%= vm.domainLink.domain %></a>
                    <% } %>
                    <button class="btn btn-xs btn-ghost text-pollen hover:text-primary" onclick='openEditModal(<%- vm.itemJson %>)' title="Rediger vare" aria-label="Rediger vare">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" /></svg>
                    </button>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    <% }); %>
  <% } %>
  
  <dialog id="add_inventory_modal" class="modal">
    <div class="modal-box">
      <h3 class="font-bold text-lg mb-4">Legg til vare i stabburet</h3>
      <form hx-post="/stabbur" hx-target="#main-content" hx-push-url="true" onsubmit="document.getElementById('add_inventory_modal').close()">
        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Navn</span></label>
          <input type="text" name="name" required class="input input-bordered w-full" placeholder="f.eks. Sommerhonning" />
        </div>
        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Kategori</span></label>
          <select name="category" class="select select-bordered" required>
            <option value="Honning og sukker">Honning og sukker</option>
            <option value="Gjær og kulturer">Gjær og kulturer</option>
            <option value="Gjærnæring og tilsetninger">Gjærnæring og tilsetninger</option>
            <option value="Frukt, bær og krydder">Frukt, bær og krydder</option>
          </select>
        </div>
        <div class="flex gap-4 mb-3">
          <div class="form-control w-1/2">
            <label class="label"><span class="label-text">Antall på lager</span></label>
            <input type="number" step="0.01" name="quantity" required class="input input-bordered w-full" />
          </div>
          <div class="form-control w-1/2">
            <label class="label"><span class="label-text">Enhet</span></label>
            <select name="unit" class="select select-bordered" required>
              <option value="g">g</option>
              <option value="kg">kg</option>
              <option value="ml">ml</option>
              <option value="L">L</option>
              <option value="packets">pakker</option>
              <option value="oz">oz</option>
              <option value="lb">lb</option>
              <option value="tsp">ts</option>
              <option value="tbsp">ss</option>
            </select>
          </div>
        </div>
        <div class="flex gap-4 mb-3">
          <div class="form-control w-1/2">
            <label class="label"><span class="label-text">Pris per enhet (valgfritt)</span></label>
            <input type="number" step="0.01" name="cost" class="input input-bordered w-full" />
          </div>
          <div class="form-control w-1/2">
            <label class="label"><span class="label-text">Valuta</span></label>
            <input type="text" name="currency" class="input input-bordered w-full" value="NOK" />
          </div>
        </div>
        <div class="form-control w-full mb-5">
          <label class="label"><span class="label-text">Lenke (valgfri nettadresse)</span></label>
          <input type="url" name="url" class="input input-bordered w-full" placeholder="https://..." />
        </div>
        <div class="modal-action">
          <button type="button" class="btn" onclick="document.getElementById('add_inventory_modal').close()">Avbryt</button>
          <button type="submit" class="btn btn-primary">Legg til vare</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>lukk</button>
    </form>
  </dialog>

  <dialog id="edit_inventory_modal" class="modal">
    <div class="modal-box">
      <h3 class="font-bold text-lg mb-4">Rediger vare</h3>
      <form id="edit_inventory_form" hx-post="/stabbur/edit" hx-target="#main-content" hx-push-url="true" onsubmit="document.getElementById('edit_inventory_modal').close()">
        <input type="hidden" name="id" id="edit-id" />
        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Navn</span></label>
          <input type="text" name="name" id="edit-name" required class="input input-bordered w-full" />
        </div>
        <div class="form-control w-full mb-3">
          <label class="label"><span class="label-text">Kategori</span></label>
          <select name="category" id="edit-category" class="select select-bordered" required>
            <option value="Honning og sukker">Honning og sukker</option>
            <option value="Gjær og kulturer">Gjær og kulturer</option>
            <option value="Gjærnæring og tilsetninger">Gjærnæring og tilsetninger</option>
            <option value="Frukt, bær og krydder">Frukt, bær og krydder</option>
          </select>
        </div>
        <div class="flex gap-4 mb-3">
          <div class="form-control w-1/2">
            <label class="label"><span class="label-text">Antall på lager</span></label>
            <input type="number" step="0.01" name="quantity" id="edit-quantity" required class="input input-bordered w-full" />
          </div>
          <div class="form-control w-1/2">
            <label class="label"><span class="label-text">Enhet</span></label>
            <select name="unit" id="edit-unit" class="select select-bordered" required>
              <option value="g">g</option>
              <option value="kg">kg</option>
              <option value="ml">ml</option>
              <option value="L">L</option>
              <option value="packets">pakker</option>
              <option value="oz">oz</option>
              <option value="lb">lb</option>
              <option value="tsp">ts</option>
              <option value="tbsp">ss</option>
            </select>
          </div>
        </div>
        <div class="flex gap-4 mb-3">
          <div class="form-control w-1/2">
            <label class="label"><span class="label-text">Pris per enhet (valgfritt)</span></label>
            <input type="number" step="0.01" name="cost" id="edit-cost" class="input input-bordered w-full" />
          </div>
          <div class="form-control w-1/2">
            <label class="label"><span class="label-text">Valuta</span></label>
            <input type="text" name="currency" id="edit-currency" class="input input-bordered w-full" />
          </div>
        </div>
        <div class="form-control w-full mb-5">
          <label class="label"><span class="label-text">Lenke (valgfri nettadresse)</span></label>
          <input type="url" name="url" id="edit-url" class="input input-bordered w-full" />
        </div>
        <div class="modal-action flex justify-between items-center">
          <button type="button" id="delete-inventory-btn" class="btn btn-ghost text-error" onclick="deleteCurrentInventoryItem()">Slett</button>
          <div class="flex gap-2">
            <button type="button" class="btn" onclick="document.getElementById('edit_inventory_modal').close()">Avbryt</button>
            <button type="submit" class="btn btn-primary">Lagre endringer</button>
          </div>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>lukk</button>
    </form>
  </dialog>

  <script>
    function openEditModal(item) {
      document.getElementById('edit-id').value = item.id;
      document.getElementById('edit-name').value = item.name;
      document.getElementById('edit-category').value = item.category;
      document.getElementById('edit-quantity').value = item.quantity_on_hand;
      document.getElementById('edit-unit').value = item.unit;
      document.getElementById('edit-cost').value = item.cost_per_unit || '';
      document.getElementById('edit-currency').value = item.currency || 'NOK';
      document.getElementById('edit-url').value = item.url || '';
      
      document.getElementById('edit_inventory_modal').showModal();
    }

    function deleteCurrentInventoryItem() {
      const id = document.getElementById('edit-id').value;
      if (!id) return;
      if (confirm('Er du sikker på at du vil slette denne varen?')) {
        document.getElementById('edit_inventory_modal').close();
        const endpoint = window.location.pathname.startsWith('/pantry') ? '/pantry/' : '/stabbur/';
        htmx.ajax('DELETE', endpoint + id, { target: '#main-content', pushUrl: true });
      }
    }
  </script>
</div>
